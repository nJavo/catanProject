{
  "manifest_version": 3,
  "name": "Catan Lab move advisor",
  "version": "0.1.0",
  "description": "Screenshots the visible tab when you ask and gets a move from your local Catan Lab server. Doesn't read or control colonist.io.",
  "key": "",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Catan advisor"
  },
  "options_page": "options.html",
  "commands": {
    "analyze": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Analyze the visible tab"
    }
  }
}
